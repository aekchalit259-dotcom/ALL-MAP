-- 9. ESP (มองเห็นผู้เล่นผ่านกำแพง)
CreateButton("👁️ ESP มองทะลุ (เปิด/ปิด)", function(btn)
    State.ESP = not State.ESP
    btn.Text = "👁️ ESP: " .. (State.ESP and "เปิด" or "ปิด")
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if State.ESP then
                if not player.Character:FindFirstChild("Highlight") then
                    local Highlight = Instance.new("Highlight")
                    Highlight.Name = "Highlight"
                    Highlight.FillColor = Color3.fromRGB(255, 0, 0)
                    Highlight.Parent = player.Character
                end
            else
                if player.Character:FindFirstChild("Highlight") then
                    player.Character.Highlight:Destroy()
                end
            end
        end
    end
end)

-- 10. FPS Boost (ลดการกระตุก)
CreateButton("⚡ FPS Boost (ลดความแล็ค)", function(btn)
    State.FPSBoost = not State.FPSBoost
    btn.Text = "⚡ FPS Boost: " .. (State.FPSBoost and "เปิด" or "ปิด")
    
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") then
            v.Material = Enum.Material.SmoothPlastic
            v.CastShadow = not State.FPSBoost
        elseif v:IsA("Decal") or v:IsA("Texture") then
            v.Transparency = State.FPSBoost and 1 or 0
        end
    end
end)

