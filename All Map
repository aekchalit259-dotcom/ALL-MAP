-- ฟังก์ชันสร้างปุ่มในเมนู
local function CreateButton(text, callback)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, 0, 0, 35)
    Btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Btn.Text = text
    Btn.Parent = ScrollFrame
    Btn.MouseButton1Click:Connect(function()
        callback(Btn)
    end)
    return Btn
end

-- 2. ระบบบิน (Fly) + ปุ่มเปิด-ปิดบนหน้าจอ
local FlyBtnOnScreen = Instance.new("TextButton")
FlyBtnOnScreen.Size = UDim2.new(0, 80, 0, 40)
FlyBtnOnScreen.Position = UDim2.new(0, 10, 0.5, 0)
FlyBtnOnScreen.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
FlyBtnOnScreen.TextColor3 = Color3.fromRGB(255, 255, 255)
FlyBtnOnScreen.Text = "บิน: ปิด"
FlyBtnOnScreen.Visible = false
FlyBtnOnScreen.Parent = ScreenGui

local BodyVelocity, BodyGyro
local function ToggleFly()
    State.Fly = not State.Fly
    FlyBtnOnScreen.Text = State.Fly and "บิน: เปิด" or "บิน: ปิด"
    FlyBtnOnScreen.BackgroundColor3 = State.Fly and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)
    
    local Character = LocalPlayer.Character
    if not Character or not Character:FindFirstChild("HumanoidRootPart") then return end
    
    if State.Fly then
        BodyVelocity = Instance.new("BodyVelocity")
        BodyGyro = Instance.new("BodyGyro")
        
        BodyVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        BodyVelocity.Parent = Character.HumanoidRootPart
        
        BodyGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
        BodyGyro.Parent = Character.HumanoidRootPart
        
        task.spawn(function()
            while State.Fly do
                RunService.RenderStepped:Wait()
                local Camera = workspace.CurrentCamera
                BodyGyro.CFrame = Camera.CFrame
                BodyVelocity.Velocity = Camera.CFrame.LookVector * 50
            end
        end)
    else
        if BodyVelocity then BodyVelocity:Destroy() end
        if BodyGyro then BodyGyro:Destroy() end
    end
end

FlyBtnOnScreen.MouseButton1Click:Connect(ToggleFly)

CreateButton("🐲 ระบบบิน (แสดงปุ่มบิน)", function(btn)
    FlyBtnOnScreen.Visible = not FlyBtnOnScreen.Visible
end)

